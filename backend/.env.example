# --- LLM ---
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# --- Speech-to-text (pick one) ---
STT_PROVIDER=openai          # openai | local
OPENAI_API_KEY=
# --- Database / auth / storage (Supabase) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/curanex
SUPABASE_URL=
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=curanex-uploads
REDIS_URL=redis://localhost:6379/0
# --- Model workers ---
WORKER_TABULAR_URL=http://localhost:8101
WORKER_TORCH_URL=http://localhost:8102
WORKER_TF_URL=http://localhost:8103
RETRIEVAL_THRESHOLD=0.35
RETRIEVAL_TOP_K=4
# --- Optional ---
GOOGLE_PLACES_API_KEY=
SENTRY_DSN=
OPENAI_API_KEY=
STT_MODEL=whisper-1
