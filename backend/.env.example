# --- LLM: any OpenAI-compatible API with tool calling. Pick one block. ---
# Groq (free, no card; also serves Whisper for voice): https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Google Gemini (free tier): https://aistudio.google.com/apikey
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
# OpenRouter free models: https://openrouter.ai/keys
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Ollama on this machine (free, offline, slower; no key):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b
# Vercel AI Gateway (paid credits) overrides the above when set:
AI_GATEWAY_API_KEY=
# --- Speech-to-text: empty values reuse the LLM key/URL (works with Groq) ---
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=whisper-large-v3-turbo
# --- Model search ---
RETRIEVAL_THRESHOLD=0.35
RETRIEVAL_TOP_K=4
# --- Model workers (docker-compose sets these for the api container) ---
WORKER_TABULAR_URL=http://localhost:8101
WORKER_TORCH_URL=http://localhost:8102
WORKER_TF_URL=http://localhost:8103
# --- Infra (later phases) ---
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=
GOOGLE_PLACES_API_KEY=
SENTRY_DSN=
